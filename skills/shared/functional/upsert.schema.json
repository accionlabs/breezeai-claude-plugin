{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breeze.ai/schemas/functional/upsert.schema.json",
  "title": "Functional Graph Upsert Payload (v2) — unified",
  "description": "ONE schema for every generator (ui / backend / p3 / aspx). Persona is a free string (C1: the backend enforces no enum — PersonaDto.persona is @IsString @IsNotEmpty; persona-KIND is gated by validate.py persona --kind, not by the schema). apis[].type is a free string (C5: free text server-side; recommended set REST / GraphQL / gRPC / WebSocket / Event / SOAP). The single persona per payload (minItems/maxItems 1) preserves the one-EP-one-upsert write protocol.",
  "type": "object",
  "required": ["personas"],
  "additionalProperties": false,
  "properties": {
    "personas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["persona", "outcomes"],
        "additionalProperties": false,
        "properties": {
          "persona":     { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] },
          "citations":   { "type": "array", "items": { "$ref": "#/$defs/citation" } },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["outcome", "scenarios"],
              "additionalProperties": false,
              "properties": {
                "outcome":     { "type": "string", "minLength": 1 },
                "description": { "type": ["string", "null"] },
                "citations":   { "type": "array", "items": { "$ref": "#/$defs/citation" } },
                "scenarios": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["scenario", "description", "steps"],
                    "additionalProperties": false,
                    "properties": {
                      "scenario":    { "type": "string", "minLength": 1 },
                      "description": { "type": "string", "minLength": 1 },
                      "citations":   { "type": "array", "items": { "$ref": "#/$defs/citation" } },
                      "steps": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": ["step", "actions"],
                          "additionalProperties": false,
                          "properties": {
                            "step": { "type": "string", "minLength": 1 },
                            "citations": { "type": "array", "items": { "$ref": "#/$defs/citation" } },
                            "actions": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "object",
                                "required": ["action"],
                                "additionalProperties": false,
                                "properties": {
                                  "action":      { "type": "string", "minLength": 1 },
                                  "description": { "type": ["string", "null"] },
                                  "citations":   { "type": "array", "items": { "$ref": "#/$defs/citation" } },
                                  "apis": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "required": ["type", "method", "url", "request", "response"],
                                      "additionalProperties": false,
                                      "properties": {
                                        "type":     { "type": "string", "minLength": 1, "description": "Free text. Recommended: REST | GraphQL | gRPC | WebSocket | Event | SOAP." },
                                        "method":   { "type": "string" },
                                        "url":      { "type": "string" },
                                        "request":  { "type": "string" },
                                        "response": { "type": "string" }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "required": ["type", "name", "reference"],
      "additionalProperties": false,
      "properties": {
        "type":      { "const": "code" },
        "name":      { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "pattern": "^[A-Za-z0-9_.\\-]+/" }
      }
    }
  }
}
